@startuml c4_spring_batch
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title TradeWare + Spring Batch

Person(user, "Сотрудник склада", "Загружает CSV")

System_Boundary(sys, "TradeWare") {
    Container(web, "Web Interface", "Angular", "Загрузка отчёта")
    Container(api, "Application Server", "WildFly / Java", "Приём файла, валидация формата, запуск Job")
    Container(batch, "ETL Service", "Spring Boot + Spring Batch", "ETL")
    ContainerDb(inv, "БД номенклатуры", "PostgreSQL", "Актуальные остатки")
    ContainerDb(ref, "БД справочников", "PostgreSQL", "Характеристики, промо и т.д.")
    ContainerDb(meta, "JobRepository", "PostgreSQL", "История Job")
    Container(gcs, "Файловое хранилище", "GCS", "Загруженные CSV")
}

Rel(user, web, "Загружает CSV", "HTTPS")
Rel(web, api, "REST", "JSON/HTTP")
Rel(api, gcs, "Сохраняет файл")
Rel(api, batch, "Запускает Job", "HTTP")
Rel(batch, gcs, "Читает CSV")
Rel(batch, ref, "Обогащает", "SQL")
Rel(batch, inv, "Обогащает", "SQL")
Rel(batch, meta, "Статусы Job", "JDBC")

@enduml
